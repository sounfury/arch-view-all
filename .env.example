# 配置示例：arch-view 的全局偏好。安装脚本会把它复制为工具目录下的 .env，按需修改即可。
# 所有命令都读取工具安装目录的 .env，不读取被分析项目的 .env；也可用 --env-file <文件> 指定。
# 优先级：命令行参数 > 进程环境变量 > 配置文件 > 内置默认值。
ARCH_VIEW_LANGUAGE=auto
# ARCH_VIEW_PROJECT_PATH=/Users/you/projects/example
# Semicolon-separated roots; omit to discover automatically.
# ARCH_VIEW_SOURCE_PATHS=src;lib

# Scale the whole UI, including fonts. Applied before opening the viewer.
ARCH_VIEW_UI_SCALE=1.25
# Cross-platform diagram and label zoom (independent of OS UI scaling).
ARCH_VIEW_ZOOM=1.0
ARCH_VIEW_NO_GUI=false

# 网页默认连线范围：focus 为当前模块，all 为全部模块。
ARCH_VIEW_EDGE_SCOPE=focus

# Python tests are excluded by default.
ARCH_VIEW_INCLUDE_TESTS=false
# Set to python3 if your system has no python command.
# ARCH_VIEW_PYTHON=python3
# ARCH_VIEW_OUT=architecture.edn
