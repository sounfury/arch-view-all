# 配置示例：arch-view 的全局偏好。安装脚本会把它复制为工具目录下的 .env，按需修改即可。
# 所有命令都读取工具安装目录的 .env，不读取被分析项目的 .env；也可用 --env-file <文件> 指定。
# 优先级：命令行参数 > 进程环境变量 > 配置文件 > 内置默认值。
ARCH_VIEW_LANGUAGE=auto
# ARCH_VIEW_PROJECT_PATH=/Users/you/projects/example
# Semicolon-separated roots; omit to discover automatically.
# ARCH_VIEW_SOURCE_PATHS=src;lib

# Scale the whole UI, including fonts. Applied before opening the viewer.
ARCH_VIEW_UI_SCALE=1.25
# Cross-platform diagram and label zoom (independent of OS UI scaling).
ARCH_VIEW_ZOOM=1.0
ARCH_VIEW_NO_GUI=false

# 网页默认连线范围：focus 为当前模块，all 为全部模块。
ARCH_VIEW_EDGE_SCOPE=focus
# 发现 crap 命令时在后台分析函数复杂度：auto 自动，off 关闭。
ARCH_VIEW_CRAP=auto
# crap 不在 PATH 上时指定其路径。
# ARCH_VIEW_CRAP_COMMAND=/path/to/crap

# Python tests are excluded by default.
ARCH_VIEW_INCLUDE_TESTS=false
# Set to python3 if your system has no python command.
# ARCH_VIEW_PYTHON=python3
# ARCH_VIEW_OUT=architecture.edn

# 网页 AI：auto 按命令自动识别；pi-acp 为多轮 ACP 对话；pi 为一次性提问；command 为通用命令。
# 推荐安装 pi 与 pi-acp 后启用下一行，复用本机模型与登录配置。
# ARCH_VIEW_AGENT_PROVIDER=pi-acp
# 可指定 pi-acp 路径；省略时使用 PATH 上的 pi-acp。
# ARCH_VIEW_AGENT_COMMAND=pi-acp
# 底层 pi 的路径和模型（只作用于 pi-acp）：
# ARCH_VIEW_PI_COMMAND=pi --model magpie/codex/gpt-6.1-sol
# 一次性 pi 提问（不保留对话）：
# ARCH_VIEW_AGENT_PROVIDER=pi
# ARCH_VIEW_AGENT_COMMAND=pi --model magpie/codex/gpt-6.1-sol
# 通用命令示例（所有 AI 命令仍强制运行在系统只读沙箱内）：
# ARCH_VIEW_AGENT_COMMAND=claude -p
# ARCH_VIEW_AGENT_COMMAND=codex exec
# 可选：ACP 会话快照目录，默认 ~/.local/state/arch-view/acp
# ARCH_VIEW_AGENT_STATE_DIR=/var/tmp/arch-view-acp
# Linux 沙箱依赖 Python 3、Landlock ABI >= 3 与 libseccomp；macOS 使用 sandbox-exec。
# 沙箱不可用时拒绝调用，不降级为无保护执行。
# AI 命令超时（秒），默认 180。
# ARCH_VIEW_AGENT_TIMEOUT=180
